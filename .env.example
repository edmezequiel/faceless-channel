# ==========================================
# EDM ARCHETYPE LAB — CONFIGURAÇÕES DE API (.env)
# ==========================================

# 1. ROTEADOR DE LLM E ROTEIRO (OpenRouter)
USE_LOCAL_LLM=false
USE_OPENROUTER=true
OPENROUTER_API_KEY=sk-or-v1-SUA_CHAVE_OPENROUTER_AQUI
LITELLM_DEFAULT_MODEL=openai/gpt-4o-mini

# 2. CHAVE ANTHROPIC DIRETA (Caso não use OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_ANTHROPIC_AQUI

# 3. PESQUISA FACTUAL E RAG (O Pesquisador)
TAVILY_API_KEY=tvly-SUA_CHAVE_TAVILY_AQUI

# 4. VOZ E LOCUÇÃO (Dr. Victor Vane)
ELEVENLABS_API_KEY=sk_SUA_CHAVE_ELEVENLABS_AQUI

# 5. GERAÇÃO VISUAL (Infinite Scroll / SVD / Flux / Replicate / Fal.ai)
FAL_KEY=SUA_CHAVE_FAL_AI_AQUI
# REPLICATE_API_TOKEN=r8_SUA_CHAVE_REPLICATE_AQUI

# 6. CONFIGURAÇÕES LOCAIS (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
