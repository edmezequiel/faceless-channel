# ═══════════════════════════════════════════════════════════════
# EDM ARCHETYPE LAB — Configuração do Ambiente (.env)
# ═══════════════════════════════════════════════════════════════

# Roteador Central OmniRoute (Proxy OpenAI-Compatible)
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_API_KEY="sk-omniroute-master"

# ═══════════════════════════════════════════════════════════════
# MATRIZ DE ESPECIALIZAÇÃO MULTI-MODELO (por agente)
# Cada agente da esteira pode usar um modelo diferente via OmniRoute.
# ═══════════════════════════════════════════════════════════════

# Modelo Padrão (fallback para tarefas genéricas)
LITELLM_DEFAULT_MODEL="gpt-4o-mini"

# Pesquisador & Fact-Checker (janela de contexto grande, gratuito)
RESEARCHER_MODEL="gemini-2.0-flash"

# Packaging & CTR (rápido e preciso em formatação JSON)
PACKAGING_MODEL="gpt-4o-mini"

# Script Architect (qualidade narrativa premium)
ARCHITECT_MODEL="claude-3-7-sonnet-20250219"

# TTS Scriptwriter (Anti-AI Slop — modelo forçado, o coração do roteiro)
SCRIPTWRITER_MODEL="claude-3-7-sonnet-20250219"

# Visual Storyboarder (detalhamento visual e spatial prompting)
STORYBOARDER_MODEL="gemini-2.0-flash"

# Retention Auditor (raciocínio lógico estrito e validação)
AUDITOR_MODEL="gpt-4o-mini"

# ═══════════════════════════════════════════════════════════════
# Chaves de Provedores Nativos (caso OmniRoute repasse diretamente)
# ═══════════════════════════════════════════════════════════════
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GOOGLE_API_KEY="AIza..."
# GROQ_API_KEY="gsk_..."
