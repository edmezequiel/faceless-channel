# Configurações do LiteLLM (Roteador de Nuvem)
# O modelo padrão para tarefas leves
LITELLM_DEFAULT_MODEL="gpt-4o-mini"

# Configurações do Claude Sonnet (Exigido pelo TTS Scriptwriter)
ANTHROPIC_API_KEY="sk-ant-..."

# Configurações do Ollama Local
USE_LOCAL_LLM="true"
OLLAMA_BASE_URL="http://localhost:11434"

# Chaves de API de terceiros (se usar modelos fechados adicionais)
# OPENAI_API_KEY="sk-..."
