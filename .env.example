# Configurações do Roteador Central OmniRoute (Proxy OpenAI-Compatible)
OMNIROUTE_BASE_URL="http://localhost:8000/v1"
OMNIROUTE_API_KEY="sk-omniroute-master"

# Modelo Padrão para tarefas gerais do sistema
LITELLM_DEFAULT_MODEL="gpt-4o-mini"

# Modelo Roteirista (Exigido pelo TTS Scriptwriter para Zero AI Slop)
SCRIPTWRITER_MODEL="claude-3-7-sonnet-20250219"

# Chaves de Provedores Nativos (caso OmniRoute repasse diretamente)
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
